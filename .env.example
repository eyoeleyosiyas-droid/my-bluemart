# Copy to .env (never commit the real file) or set these in your host's dashboard.

# --- Required ---
DATABASE_URL=postgresql://user:password@host:5432/bluemart
FLASK_SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=https://your-domain.example
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Admin: usernames (comma separated) that can open the Admin page ---
ADMIN_USERNAMES=

# --- Behind a proxy such as Render or nginx: set to 1 so rate limits see real visitor IPs ---
TRUST_PROXY=1
# Shared rate-limit counters (recommended in production with more than one worker)
# RATELIMIT_STORAGE_URI=redis://localhost:6379

# --- Email (Brevo SMTP) ---
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=2525
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=BlueMart
SUPPORT_EMAIL=

# --- Google sign-in (optional) ---
GOOGLE_CLIENT_ID=

# --- Shop settings (defaults shown) ---
PLATFORM_FEE_PERCENT=5.0
REFUND_WINDOW_DAYS=14
CURRENCY=usd
# CURRENCY_SYMBOL=$
MIN_PRICE=0.50
MAX_PRICE=100000
MAX_PRODUCT_IMAGES=5
# Days after delivery before an unconfirmed order is confirmed automatically (0 = never)
AUTO_CONFIRM_DAYS=7
# DB_POOL_MAX=20

# --- Business details shown in the footer and legal pages ---
BUSINESS_NAME=BlueMart
BUSINESS_ADDRESS=Addis Ababa
BUSINESS_COUNTRY=Ethiopia

# --- Local development only (turns off HTTPS-only cookies and HSTS) ---
# FLASK_ENV=development
